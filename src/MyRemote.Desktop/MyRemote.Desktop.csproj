<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MyRemote.Core\MyRemote.Core.csproj" />
    <ProjectReference Include="..\MyRemote.Storage\MyRemote.Storage.csproj" />
    <ProjectReference Include="..\MyRemote.Security\MyRemote.Security.csproj" />
    <ProjectReference Include="..\MyRemote.ScreenCapture\MyRemote.ScreenCapture.csproj" />
    <ProjectReference Include="..\MyRemote.Input\MyRemote.Input.csproj" />
    <ProjectReference Include="..\MyRemote.Network\MyRemote.Network.csproj" />
    <ProjectReference Include="..\MyRemote.FileTransfer\MyRemote.FileTransfer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>MyRemote</AssemblyName>
    <ApplicationIcon>Assets\myremote.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.5</Version>
    <AssemblyTitle>MyRemote</AssemblyTitle>
    <Product>MyRemote</Product>
    <Description>Free, Consent-First Windows Remote Desktop</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\myremote.ico" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
