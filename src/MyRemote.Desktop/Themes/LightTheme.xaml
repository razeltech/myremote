<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgBaseColor">#F4F6F9</Color>
    <Color x:Key="BgRailColor">#EBEEF3</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgElevatedColor">#F8FAFC</Color>
    <Color x:Key="BorderSubtleColor">#DCE1EA</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>

    <Color x:Key="AccentPrimaryColor">#0284C7</Color>
    <Color x:Key="AccentPrimaryHoverColor">#0369A1</Color>
    <Color x:Key="AccentSuccessColor">#059669</Color>
    <Color x:Key="AccentWarningColor">#D97706</Color>
    <Color x:Key="AccentDangerColor">#DC2626</Color>

    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgRailBrush" Color="{StaticResource BgRailColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccessColor}" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarningColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
</ResourceDictionary>
